# === Database (MySQL) ===
DB_USERNAME=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=project_pendataan_penduduk

# === Keamanan ===
# Secret untuk menandatangani token JWT. WAJIB diisi dengan string acak yang panjang.
# Contoh generate: openssl rand -hex 32
JWT_SECRET=

# === CORS ===
# URL frontend yang diizinkan mengakses API (default: http://localhost:3000)
FE_URL=http://localhost:3000
